# =============================================================================
# Check Grammar — environment template (bring your own keys)
# =============================================================================
# Copy to `.env` for local development. Never commit real keys.
# On Vercel / Render / Docker: set the SAME variable names in the host dashboard
# or compose `environment:` / `--env-file`. See README.md → Configuration.
# Secrets must NOT use the NEXT_PUBLIC_ prefix (that ships values to the browser).
# =============================================================================

# --- API (Go server / shim) ---
API_ADDR=:8080
API_PUBLIC_URL=http://localhost:8080
# Exact browser origin for CORS when the editor is hosted separately (no trailing slash)
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Postgres (optional for rules-only check; required for accounts / saved docs)
DATABASE_URL=postgres://check:check@localhost:5432/checkgrammar?sslmode=disable

# Redis (optional; hosted rewrite rate limits)
REDIS_URL=redis://localhost:6379

# JWT for hosted accounts — use a long random string in production
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production

# =============================================================================
# LLM — OpenAI-compatible (Groq free tier, or local Ollama)
# Server-side only. Used by:
#   Vercel: POST /api/rewrite, /api/generate, /api/check, GET /api/healthz
#   Go API: Enhanced augment + rewrite when pointing at LLM_BASE_URL
# =============================================================================
#
# --- Option A: Groq (recommended for Vercel / cloud rewrite + AI Write) ---
# Signup: https://console.groq.com → API keys
#   LLM_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-20b
#
# --- Option B: Local Ollama (no cloud key) ---
# Install: https://ollama.com → ollama pull llama3.2
# Then either:
#   (1) Bridge: npm run llm:serve  → LLM_BASE_URL=http://127.0.0.1:8081/v1
#   (2) Direct: LLM_BASE_URL=http://127.0.0.1:11434/v1
#
# --- Option C: llama.cpp / MLX on port 8081 ---
#
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL=llama3.2
LLM_API_KEY=

# Ollama auto-detection (ml/serve/server.py and API /healthz)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Opt-in second cloud provider (only when LLM_PROVIDER=cloud and user/BYOK key set)
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# =============================================================================
# LanguageTool (optional Enhanced grammar)
# docker compose up -d languagetool  →  http://localhost:8010
# Needs ≥1 GB RAM in cloud; leave unset for Privacy-only / rules-only
# =============================================================================
LANGUAGETOOL_URL=http://localhost:8010

# =============================================================================
# Plagiarism / originality (optional; free Winston tier)
# Compares text to published sources so writers can cite them — detection only.
# Without a key, endpoints return 200 + skippedReason (no crash).
#
# Vercel: set on the web project (POST /api/plagiarism). Redeploy after changes.
# Local Go / shim: same vars for POST /v1/plagiarism.
#
# Winston AI: https://gowinston.ai (or https://dev.gowinston.ai) → API tokens
#   PLAGIARISM_API_KEY=...
# Alternatives:
#   PLAGIARISM_PROVIDER=prepostseo  — https://www.prepostseo.com/apis
#   PLAGIARISM_PROVIDER=generic     — set PLAGIARISM_API_URL to your REST endpoint
# =============================================================================
PLAGIARISM_PROVIDER=
PLAGIARISM_API_KEY=
PLAGIARISM_API_URL=

# =============================================================================
# Billing (optional hosted SaaS — off for typical self-host / open-source use)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
BILLING_ENABLED=false
HOSTED_REWRITE_MONTHLY_QUOTA=50

# =============================================================================
# Web editor (Next.js — apps/web)
# NEXT_PUBLIC_* is safe for non-secrets only (baked into the client bundle).
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_MODE=privacy
