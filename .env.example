# Copy to .env and fill in locally. Never commit real keys.

# --- API ---
API_ADDR=:8080
API_PUBLIC_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Postgres (optional for v1 rules-only; required for accounts / saved docs)
DATABASE_URL=postgres://check:check@localhost:5432/checkgrammar?sslmode=disable

# Redis (optional; used for hosted rewrite rate limits)
REDIS_URL=redis://localhost:6379

# JWT for hosted accounts (generate a long random string)
JWT_SECRET=change-me-in-production

# --- LLM (OpenAI-compatible). Server-side only — never NEXT_PUBLIC_*. ---
#
# Vercel (apps/web — no Render/Go API required):
#   Free Groq: https://console.groq.com → API keys
#   Set in Vercel → Project → Settings → Environment Variables, then Redeploy:
#     LLM_API_KEY=gsk_...
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=openai/gpt-oss-20b
#   Routes: POST /api/rewrite, POST /api/generate, POST /api/check, GET /api/healthz
#
# Local (Mac host, NOT in Docker):
# Option A — Ollama (recommended): pull a model, then point the bridge or API at it.
#   ollama pull llama3.2
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
#   LLM_BASE_URL=http://127.0.0.1:8081/v1   # ml/serve/server.py proxies to Ollama when detected
# Option B — Direct Ollama OpenAI API (skip ml/serve):
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
# Option C — llama.cpp / MLX server on port 8081
# Option D — Groq locally (same as Vercel):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-20b
#   LLM_API_KEY=gsk_...
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL=llama3.2
LLM_API_KEY=

# Ollama auto-detection (used by ml/serve/server.py and API /healthz)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- LanguageTool (optional). Self-hosted grammar checker merged with rule engine. ---
# docker compose up languagetool  →  http://localhost:8010
LANGUAGETOOL_URL=http://localhost:8010

# Opt-in cloud fallback (disabled unless LLM_PROVIDER=cloud and user/BYOK key is set)
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# --- Plagiarism / originality check (optional; free tier) ---
# Compares text against published web sources so writers can find and cite them.
# Without a key, endpoints return 200 with skippedReason (no error).
#
# Vercel (apps/web only — no Render/Go API required):
#   Set these in Vercel → Project → Settings → Environment Variables (Production).
#   They are read by POST /api/plagiarism (server-side). Do NOT use NEXT_PUBLIC_*.
#   Redeploy after adding or changing them.
#
# Local Go API / shim: same vars for POST /v1/plagiarism.
#
# Recommended: Winston AI — free credits at signup, no credit card.
#   1. Register at https://dev.gowinston.ai (or gowinston.ai → API)
#   2. Dashboard → API tokens → create a token
#   3. Set PLAGIARISM_API_KEY below (provider defaults to winston)
# Alternatives:
#   PLAGIARISM_PROVIDER=prepostseo  — https://www.prepostseo.com/apis (free tier)
#   PLAGIARISM_PROVIDER=generic     — any REST endpoint accepting {"text"} and
#     returning {score, matches:[{text,url,similarity}]}; set PLAGIARISM_API_URL
PLAGIARISM_PROVIDER=
PLAGIARISM_API_KEY=
PLAGIARISM_API_URL=

# --- Billing (hosted GPU of OUR weights; core checker stays free) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
BILLING_ENABLED=false

# Hosted rewrite quota for the free SaaS tier (rules are never rate-limited)
HOSTED_REWRITE_MONTHLY_QUOTA=50

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_MODE=privacy
