# Production env for hosted API (Render / Fly.io / Railway / docker compose).
# Copy values into your host's dashboard or a local .env — never commit secrets.
# Same names as root .env.example. Full BYOK docs: README.md → Configuration.

# --- Required ---
# Public URL of this API (Render/Fly assign this after deploy)
API_PUBLIC_URL=https://check-grammar-api.onrender.com
API_ADDR=:8080

# Vercel editor origin — required for browser CORS (exact URL, no trailing slash)
WEB_ORIGIN=https://your-app.vercel.app

# Long random string (openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# --- LanguageTool (recommended for Enhanced grammar; needs ~1 GB RAM container) ---
# Internal URL on Render private network, Fly .internal DNS, or docker compose service name:
LANGUAGETOOL_URL=http://languagetool:8010

# --- LLM (optional; not available on free cloud without your own GPU/tunnel) ---
# Leave unset on Render — API falls back to rule engine + LT (~65% parity).
# For dev: tunnel Ollama from your Mac (cloudflared/ngrok) and set LLM_BASE_URL to the tunnel.
LLM_PROVIDER=local
# LLM_BASE_URL=https://your-tunnel.example/v1
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Web (Vercel project settings, not on the API host) ---
NEXT_PUBLIC_API_URL=https://check-grammar-api.onrender.com
NEXT_PUBLIC_DEFAULT_MODE=enhanced

# --- Plagiarism (optional; same names as root .env.example / README BYOK) ---
# Winston: https://gowinston.ai → API tokens. Or set on Vercel /api/plagiarism instead.
# PLAGIARISM_API_KEY=
# PLAGIARISM_PROVIDER=winston
# PLAGIARISM_API_URL=

# --- Optional / off by default on free deploy ---
BILLING_ENABLED=false
LOG_LEVEL=info
DATABASE_URL=
REDIS_URL=
HOSTED_REWRITE_MONTHLY_QUOTA=50
