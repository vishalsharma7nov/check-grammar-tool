{
  "manifest_version": 3,
  "name": "Check Grammar",
  "version": "0.1.0",
  "description": "As you type: sentence structure, spelling, and next-word hints. On-device. Not affiliated with Grammarly.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8080/*", "http://localhost:8080/*"],
  "action": { "default_popup": "popup.html", "default_title": "Check Grammar" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["engine.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["engine.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
