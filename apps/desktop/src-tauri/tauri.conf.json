{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev -w @check-grammar/web",
    "beforeBuildCommand": "npm run build -w @check-grammar/web",
    "devPath": "http://localhost:3000",
    "distDir": "../../web/.next"
  },
  "package": { "productName": "Check Grammar", "version": "0.1.0" },
  "tauri": {
    "allowlist": { "all": false, "shell": { "open": true } },
    "windows": [{ "title": "Check Grammar", "width": 1100, "height": 760 }],
    "security": { "csp": null },
    "bundle": { "identifier": "org.checkgrammar.desktop", "icon": [] }
  }
}
